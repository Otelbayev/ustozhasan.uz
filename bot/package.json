{
  "name": "ustoz-hasan-bot",
  "version": "2.0.0",
  "description": "Ustoz Hasan - Kompyuter savodxonligi kursi uchun Telegram sotuv voronkasi boti va integratsiya API'si",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node src/db/migrate.js",
    "bot:setup": "node scripts/setup-bot-profile.js",
    "api:key": "node scripts/generate-api-key.js",
    "seed": "node scripts/seed.js",
    "loadtest": "node scripts/loadtest.js"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "pg": "^8.13.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
