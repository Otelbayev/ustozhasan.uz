# ─────────────────────────────────────────────────────────────
# Ustoz Hasan boti — muhit sozlamalari
#
# LOCAL uchun: shu faylni `.env` ga nusxalang va faqat BOT_TOKEN,
# CHANNEL_USERNAME, CHANNEL_INVITE_LINK ni to'ldiring. Qolgani tayyor.
#   cp .env.example .env
#
# ⚠️ .env ni HECH QACHON git'ga qo'shmang (.gitignore'da bor).
# ─────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────
# BotFather bergan token.
# TAVSIYA: local uchun ALOHIDA dev bot oching. Bitta token bilan bir vaqtda
# ikki joyda polling ishlata olmaysiz — local `npm run dev` production botini
# uzib qo'yadi.
BOT_TOKEN=

# Obuna tekshiriladigan kanal: @username yoki -100... formatidagi ID.
# ⚠️ Bot o'sha kanalda ADMIN bo'lishi shart, aks holda getChatMember ishlamaydi.
CHANNEL_USERNAME=
CHANNEL_INVITE_LINK=

# Admin Telegram user ID lari (vergul bilan). /stats kabi buyruqlar uchun.
ADMIN_IDS=

# ── Baza ─────────────────────────────────────────────────────
# Local (docker compose up -d db bilan ishga tushadi):
DATABASE_URL=postgres://ustoz:ustoz@localhost:5433/ustoz
# Production (managed Postgres) — sslmode=require qo'shishni unutmang:
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# ── Server ───────────────────────────────────────────────────
PORT=3000
# development | production. Bo'sh bo'lsa development deb hisoblanadi.
NODE_ENV=development

# ── Webhook (FAQAT production uchun) ──────────────────────────
# Bo'sh qoldirilsa bot POLLING rejimida ishlaydi — local uchun aynan shu kerak.
# To'ldirilsa WEBHOOK_SECRET ham majburiy (kamida 32 belgi), aks holda bot
# ishga tushmaydi.
#   Sir yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_DOMAIN=
WEBHOOK_SECRET=

# ── Integratsiya API ─────────────────────────────────────────
# API kalitlarining SHA-256 hash'lari (vergul bilan). Kalitning O'ZI bu yerda
# saqlanmaydi. Yaratish:  npm run api:key
API_KEYS_SHA256=

# API'ga ruxsat etilgan IP/CIDR lar (vergul bilan). Bo'sh = IP tekshiruvi
# o'chiq (kalit baribir majburiy). Production'da to'ldiring.
# Masalan: API_ALLOWED_IPS=203.0.113.10,10.0.0.0/8
API_ALLOWED_IPS=

# ── Sayt arizalari (POST /api/v1/leads) ───────────────────────
# Sayt formasidan kelgan arizalar shu chatga yuboriladi.
# LEADS_BOT_TOKEN bo'sh bo'lsa BOT_TOKEN ishlatiladi.
LEADS_BOT_TOKEN=
LEADS_CHAT_ID=
# Arizalarni qabul qilish uchun ruxsat etilgan sayt manzillari (vergul bilan).
# Bo'sh = Origin tekshiruvi o'chiq (faqat local uchun).
LEADS_ALLOWED_ORIGINS=http://localhost:5173,https://ustozhasan.uz

# ── Umumiy ───────────────────────────────────────────────────
PUBLIC_SITE_URL=https://ustozhasan.uz
